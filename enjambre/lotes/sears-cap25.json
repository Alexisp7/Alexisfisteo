  {
   "id": "sz25-p25-1",
   "title": "¿Campo eléctrico dentro de un conductor?",
   "text": "",
   "key": "E = 0 solo en equilibrio electrostático; con corriente estacionaria el conductor no está en equilibrio.",
   "topics": [
    "circ"
   ],
   "prio": "clave",
   "dif": "facil",
   "pillar": false,
   "state": 0,
   "source": "Sears-Zemansky, cap. 25, pregunta de análisis P25.1",
   "notes": "",
   "hints": [
    "¿Qué suponía el capítulo 21 sobre el movimiento de las cargas?"
   ],
   "sol": [
    "E = 0 dentro de un conductor vale cuando las cargas están en reposo.",
    "Si circula corriente, hace falta un campo E = ρJ que empuje las cargas contra las colisiones.",
    "No hay contradicción: son situaciones distintas."
   ],
   "ans": [
    "No hay contradicción: E = 0 solo en equilibrio; con corriente E = ρJ"
   ],
   "img": "img/sz25-p25-1.png",
   "num": "P25.1"
  },
